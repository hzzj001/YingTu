<?xml version="1.0" encoding="utf-8"?>
<!-- 移植自上游 webhtv (https://github.com/fish2018/webhtv, HEAD 4e30ffa)：包名 com.fongmi.android.tv -> com.yingtu.plus，逻辑未改。 -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#33FFFFFF">
    <item>
        <selector>
            <item android:state_pressed="true">
                <shape android:shape="rectangle">
                    <corners android:radius="7dp" />
                    <solid android:color="#66FFFFFF" />
                    <stroke
                        android:width="2dp"
                        android:color="#D9FFFFFF" />
                </shape>
            </item>
            <item android:state_selected="true">
                <shape android:shape="rectangle">
                    <corners android:radius="7dp" />
                    <solid android:color="#5CFFFFFF" />
                    <stroke
                        android:width="2dp"
                        android:color="#BFFFFFFF" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="7dp" />
                    <solid android:color="#1FFFFFFF" />
                    <stroke
                        android:width="1dp"
                        android:color="#14FFFFFF" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>
